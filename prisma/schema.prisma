datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  USER
  COLLEGE_ADMIN
  AGENT
  ADMIN
}

enum CollegeType {
  GOVERNMENT
  PRIVATE
  DEEMED
  AUTONOMOUS
  CENTRAL
  INTERNATIONAL
}

enum Stream {
  ENGINEERING
  MEDICAL
  ARTS
  COMMERCE
  SCIENCE
  LAW
  MANAGEMENT
  DESIGN
  PHARMACY
  AGRICULTURE
  EDUCATION
  HOTEL_MANAGEMENT
  ARCHITECTURE
  NURSING
  SOCIAL_SCIENCE
  MEDIA
  INFORMATION_TECHNOLOGY
  OTHER
}

enum DegreeType {
  BACHELOR
  MASTER
  DIPLOMA
  PHD
  CERTIFICATE
  INTEGRATED
  ASSOCIATE
}

enum StudyMode {
  FULL_TIME
  PART_TIME
  ONLINE
  DISTANCE
  HYBRID
}

enum CollegeGender {
  CO_ED
  BOYS_ONLY
  GIRLS_ONLY
}

enum CollegeStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  ARCHIVED
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
  ENROLLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  RESPONDED
  CLOSED
  SPAM
}

enum SessionType {
  IN_PERSON
  VIDEO_CALL
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AccreditationType {
  NAAC
  NBA
  NIRF
  QS
  TIMES
  ARWU
  OTHER
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_REVIEWED
  ENQUIRY_RECEIVED
  SESSION_BOOKED
  SESSION_CONFIRMED
  SESSION_REJECTED
  COLLEGE_APPROVED
  COLLEGE_REJECTED
  MESSAGE_RECEIVED
  ADMIN_ALERT
}

enum ReportReason {
  FAKE_COLLEGE
  INCORRECT_INFORMATION
  DUPLICATE_LISTING
  SPAM
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ImageCategory {
  EXTERIOR
  CAMPUS
  CLASSROOM
  HOSTEL
  LIBRARY
  SPORTS
  LAB
  AUDITORIUM
  OTHER
}

// ─────────────────────────────────────────
// AUTH & USER
// ─────────────────────────────────────────

model User {
  id                     String              @id @default(uuid())
  customId               String?             @unique
  email                  String              @unique
  passwordHash           String
  plainPassword          String?
  name                   String
  phone                  String?
  city                   String?
  country                String?
  role                   Role                @default(USER)
  avatar                 String?
  isEmailVerified        Boolean             @default(false)
  isApproved             Boolean             @default(false)
  isSuspended            Boolean             @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?

  // Relations
  colleges               College[]           @relation("CollegeOwner")
  applications           Application[]       @relation("StudentApplications")
  enquiries              CollegeEnquiry[]    @relation("StudentEnquiries")
  sessions               CounsellingSession[] @relation("StudentSessions")
  sentMessages           Message[]           @relation("SentMessages")
  rcvdMessages           Message[]           @relation("ReceivedMessages")
  conversations          Conversation[]      @relation("ConversationParticipants")
  notifications          Notification[]
  reports                CollegeReport[]
  recentlyViewed         RecentlyViewed[]
  reviewsWritten         Review[]            @relation("ReviewsWritten")
  shortlists             Shortlist[]
  collegeProfile         CollegeProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model CollegeProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String?
  designation     String?
  bio             String?
  ratingAverage   Float    @default(0.0)
  isFeatured      Boolean  @default(true)
  reviews         Review[] @relation("CollegeProfileReviews")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────
// GEOGRAPHY
// ─────────────────────────────────────────

model Country {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique   // IN, US, GB, AU, CA, DE
  flag      String?             // emoji or image URL
  cities    City[]
  colleges  College[]
  scholarships Scholarship[]
  exams     EntranceExam[]
  createdAt DateTime  @default(now())

  @@index([code])
}

model City {
  id        String    @id @default(uuid())
  name      String
  slug      String
  countryId String
  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  colleges  College[]
  createdAt DateTime  @default(now())

  @@unique([name, countryId])
  @@index([countryId])
}

// ─────────────────────────────────────────
// COLLEGE CORE
// ─────────────────────────────────────────

model College {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  description      String
  collegeType      CollegeType   @default(PRIVATE)
  countryId        String
  country          Country       @relation(fields: [countryId], references: [id])
  cityId           String
  city             City          @relation(fields: [cityId], references: [id])
  state            String?
  address          String
  pincode          String?
  latitude         Float?
  longitude        Float?
  website          String?
  phone            String?
  email            String?
  establishedYear  Int?
  totalStudents    Int?
  campusArea       String?       // "120 acres"
  gender           CollegeGender @default(CO_ED)
  affiliation      String?       // "Mumbai University", "Autonomous"
  nirfRanking      Int?
  qsRanking        Int?
  timesRanking     Int?
  isVerified       Boolean       @default(false)
  isFeatured       Boolean       @default(false)
  status           CollegeStatus @default(DRAFT)
  rejectionReason  String?
  viewCount        Int           @default(0)
  hasScholarship       Boolean       @default(false)
  scholarshipDetails   String?
  hasEntranceExam      Boolean       @default(false)
  entranceExamDetails  String?

  // Owner (College Admin)
  ownerId          String
  owner            User          @relation("CollegeOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Relations
  accreditations   Accreditation[]
  courses          Course[]
  images           CollegeImage[]
  facilities       CollegeFacility[]
  reviews          Review[]
  applications     Application[]
  enquiries        CollegeEnquiry[]
  sessions         CounsellingSession[]
  shortlists       Shortlist[]
  reports          CollegeReport[]
  recentlyViewed   RecentlyViewed[]
  conversations    Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([cityId])
  @@index([collegeType])
  @@index([status])
  @@index([isFeatured])
  @@index([isVerified])
  @@index([ownerId])
  @@index([nirfRanking])
  @@index([createdAt])
}

model Accreditation {
  id         String            @id @default(uuid())
  collegeId  String
  college    College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  type       AccreditationType
  grade      String?           // "A++", "A+", "Gold"
  year       Int?
  validUntil DateTime?

  @@index([collegeId])
}

model CollegeImage {
  id         String        @id @default(uuid())
  collegeId  String
  college    College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  url        String
  publicId   String?
  altText    String?
  category   ImageCategory @default(EXTERIOR)
  isPrimary  Boolean       @default(false)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([collegeId])
  @@index([isPrimary])
}

model CollegeFacility {
  id        String  @id @default(uuid())
  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name      String  // "Hostel", "Library", "Sports Complex", "WiFi", "Cafeteria"
  icon      String?

  @@index([collegeId])
}

// ─────────────────────────────────────────
// COURSE
// ─────────────────────────────────────────

model Course {
  id                   String      @id @default(uuid())
  collegeId            String
  college              College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name                 String      // "B.Tech Computer Science"
  degree               DegreeType
  stream               Stream
  durationYears        Float       // 4.0, 1.5, 2.0
  totalSeats           Int?
  annualFees           Decimal     @db.Decimal(15, 2)
  feeCurrency          String      @default("INR")  // INR, USD, GBP, AUD
  mode                 StudyMode   @default(FULL_TIME)
  eligibility          String
  entranceExams        String[]    // ["JEE", "SAT", "IELTS"]
  languageRequirement  String?     // "IELTS 6.5 or TOEFL 90"
  placementRate        Float?      // percentage 0-100
  avgSalary            Decimal?    @db.Decimal(15, 2)
  highestSalary        Decimal?    @db.Decimal(15, 2)
  salaryCurrency       String?     @default("INR")
  scholarshipAvailable Boolean     @default(false)
  applicationDeadline  DateTime?
  startDate            DateTime?
  isActive             Boolean     @default(true)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@index([stream])
  @@index([degree])
  @@index([mode])
  @@index([isActive])
}

// ─────────────────────────────────────────
// STUDENT ACTIONS
// ─────────────────────────────────────────

model Application {
  id          String            @id @default(uuid())
  studentId   String
  student     User              @relation("StudentApplications", fields: [studentId], references: [id], onDelete: Cascade)
  collegeId   String
  college     College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String?
  message     String?
  documents   String[]          // uploaded file URLs
  status      ApplicationStatus @default(NEW)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([studentId])
  @@index([collegeId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

model CollegeEnquiry {
  id         String        @id @default(uuid())
  studentId  String
  student    User          @relation("StudentEnquiries", fields: [studentId], references: [id], onDelete: Cascade)
  collegeId  String
  college    College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseId   String?
  name       String
  email      String
  phone      String?
  message    String
  status     EnquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([studentId])
  @@index([collegeId])
  @@index([status])
  @@index([createdAt])
}

model CounsellingSession {
  id          String        @id @default(uuid())
  studentId   String
  student     User          @relation("StudentSessions", fields: [studentId], references: [id], onDelete: Cascade)
  collegeId   String
  college     College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  date        DateTime
  timeSlot    String
  type        SessionType   @default(VIDEO_CALL)
  status      SessionStatus @default(PENDING)
  notes       String?
  meetingLink String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([studentId])
  @@index([collegeId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
}

model Shortlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseId  String?
  createdAt DateTime @default(now())

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
  @@index([viewedAt])
}

// ─────────────────────────────────────────
// SCHOLARSHIPS & EXAMS
// ─────────────────────────────────────────

model Scholarship {
  id          String      @id @default(uuid())
  name        String
  provider    String
  countryId   String?
  country     Country?    @relation(fields: [countryId], references: [id], onDelete: SetNull)
  amount      Decimal?    @db.Decimal(15, 2)
  currency    String      @default("INR")
  deadline    DateTime?
  eligibility String
  stream      Stream?
  degree      DegreeType?
  link        String?
  isFeatured  Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([countryId])
  @@index([stream])
  @@index([degree])
  @@index([isFeatured])
}

model EntranceExam {
  id               String    @id @default(uuid())
  name             String    @unique // JEE, NEET, CAT, IELTS, SAT, GRE
  fullName         String
  countryId        String?
  country          Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  stream           Stream?
  degree           DegreeType?
  description      String?
  conductedBy      String?
  frequency        String?   // "Annual", "Twice a year"
  website          String?
  cutoffScore      String?   // E.g. "Score: 1450-1580 / 1600"
  acceptedCutoffs  String?   // Detailed cutoffs for top colleges
  registrationDate DateTime?
  examDate         DateTime?
  isFeatured       Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([countryId])
  @@index([stream])
  @@index([isFeatured])
}

// ─────────────────────────────────────────
// REVIEWS & REPORTS
// ─────────────────────────────────────────

model Review {
  id               String         @id @default(uuid())
  reviewerId       String
  reviewer         User           @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  collegeId        String
  college          College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  collegeProfileId String?
  collegeProfile   CollegeProfile? @relation("CollegeProfileReviews", fields: [collegeProfileId], references: [id], onDelete: SetNull)
  rating           Int            // 1-5
  comment          String
  createdAt        DateTime       @default(now())

  @@unique([reviewerId, collegeId])
  @@index([collegeId])
  @@index([reviewerId])
}

model CollegeReport {
  id         String       @id @default(uuid())
  collegeId  String
  college    College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String
  createdAt  DateTime     @default(now())

  @@index([collegeId])
  @@index([reporterId])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// MESSAGING & NOTIFICATIONS
// ─────────────────────────────────────────

model Conversation {
  id           String     @id @default(uuid())
  collegeId    String?
  college      College?   @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  participants User[]     @relation("ConversationParticipants")
  messages     Message[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([collegeId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// ADDS BUZZ (ADVERTISEMENTS)
// ─────────────────────────────────────────

enum AdPlacement {
  HOME_ONLY
  INNER_ONLY
  BOTH
  COLLEGES_ONLY
  COLLEGE_DETAIL_ONLY
  SCHOLARSHIPS_ONLY
  EXAMS_ONLY
}

enum AdFormat {
  FULL_WIDTH
  HALF_WIDTH
  QUAD_GRID
}

model Advertisement {
  id           String      @id @default(uuid())
  name         String
  imageUrl     String
  targetUrl    String
  placement    AdPlacement @default(BOTH)
  format       AdFormat    @default(FULL_WIDTH)
  isExclusive  Boolean     @default(false)
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)
  clickCount   Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([placement])
  @@index([isActive])
  @@index([displayOrder])
  @@index([isExclusive])
}
